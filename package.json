{
  "name": "mokelay-server-core",
  "version": "0.1.35",
  "description": "Core server utilities for Mokelay.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./utils/blocks": {
      "types": "./dist/utils/blocks/index.d.ts",
      "default": "./dist/utils/blocks/index.js"
    },
    "./utils/blocks/*": {
      "types": "./dist/utils/blocks/*.d.ts",
      "default": "./dist/utils/blocks/*.js"
    },
    "./utils/controllers": {
      "types": "./dist/utils/controllers/index.d.ts",
      "default": "./dist/utils/controllers/index.js"
    },
    "./utils/controllers/*": {
      "types": "./dist/utils/controllers/*.d.ts",
      "default": "./dist/utils/controllers/*.js"
    },
    "./utils/processors": {
      "types": "./dist/utils/processors/index.d.ts",
      "default": "./dist/utils/processors/index.js"
    },
    "./utils/processors/*": {
      "types": "./dist/utils/processors/*.d.ts",
      "default": "./dist/utils/processors/*.js"
    },
    "./utils/*": {
      "types": "./dist/utils/*.d.ts",
      "default": "./dist/utils/*.js"
    }
  },
  "scripts": {
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "build:watch": "npx tsc -p tsconfig.build.json --watch",
    "publish:npm": "node scripts/publish.mjs",
    "test": "vitest run --passWithNoTests",
    "prepublishOnly": "npm run typecheck && npm run build && npm test"
  },
  "dependencies": {
    "@adonisjs/hash": "^9.1.1",
    "@aws-sdk/client-s3": "^3.1053.0",
    "@vue-flow/core": "1.48.2",
    "@vue/server-renderer": "3.5.22",
    "axios": "1.8.1",
    "drizzle-orm": "^0.44.5",
    "echarts": "6.0.0",
    "element-ui": "npm:element-plus@2.14.0",
    "h3": "^1.15.4",
    "json-editor-vue": "0.18.1",
    "mokelay-components": "0.2.13",
    "mysql2": "^3.22.3",
    "nodemailer": "9.0.3",
    "openai": "^6.36.0",
    "postgres": "^3.4.7",
    "qrcode": "1.5.4",
    "vanilla-jsoneditor": "3.6.1",
    "vue": "3.5.22",
    "zod": "^3.25.76"
  },
  "peerDependencies": {
    "nitropack": "^2.12.9"
  },
  "peerDependenciesMeta": {
    "nitropack": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "@types/nodemailer": "8.0.1",
    "nitropack": "^2.12.9",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20"
  }
}
